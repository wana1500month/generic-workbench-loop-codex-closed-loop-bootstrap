{
  "profile_id": "semantic-validation-editor-semantic",
  "label": "Semantic Validation Editor Deterministic",
  "bundle_label": "Semantic Validation Editor Deterministic",
  "target_family": "browser-editor",
  "validation_lane": "deterministic_semantic",
  "expected_target_surfaces": [
    "api"
  ],
  "required_live_verification_modes": [
    "browser",
    "api"
  ],
  "target_reached_requires_core_probes": true,
  "minimum_feature_release_assertions": 9,
  "minimum_assertion_tag_counts": {
    "api": 6,
    "error_path": 2,
    "undo_redo": 2,
    "workflow_multi_step": 5,
    "persistence": 2
  },
  "score_policy": {
    "proof_weights": {
      "proof_pass_rate": 0.3,
      "criterion_pass_rate": 0.35,
      "threshold_verdict": 0.1,
      "external_grade": 0.25
    },
    "release_weights": {
      "control_plane_score": 0.4,
      "proof_score": 0.6
    }
  },
  "core_probes": [
    {
      "probe_id": "editor-semantic-health",
      "label": "Editor semantic lane health endpoint",
      "role": "supporting",
      "mode": "http",
      "target_manifest_key": "health_url",
      "expected_value": "\"status\":\"ready\"",
      "required": true
    },
    {
      "probe_id": "editor-semantic-shell",
      "label": "Editor semantic lane confirms the shell remains visible",
      "role": "release_gate",
      "mode": "http_json",
      "assertion_id": "editor_shell_renders",
      "assertion_tags": [
        "api"
      ],
      "semantic_level": "feature",
      "target_manifest_key": "api_base_url",
      "target_path": "editor/summary",
      "json_path": "shell",
      "expected_value": "visible",
      "expected_status": 200,
      "required": true
    },
    {
      "probe_id": "editor-semantic-invalid-flow",
      "label": "Editor semantic lane confirms invalid flows are rejected",
      "role": "release_gate",
      "mode": "http_json",
      "assertion_id": "invalid_editor_flow_rejected",
      "assertion_tags": [
        "api",
        "error_path"
      ],
      "semantic_level": "workflow",
      "target_manifest_key": "api_base_url",
      "target_path": "editor/invalid",
      "json_path": "status",
      "expected_value": "rejected",
      "expected_status": 400,
      "required": true
    },
    {
      "probe_id": "editor-semantic-undo",
      "label": "Editor semantic lane confirms undo remains available",
      "role": "release_gate",
      "mode": "http_json",
      "assertion_id": "undo_redo_available",
      "assertion_tags": [
        "api",
        "undo_redo",
        "workflow_multi_step"
      ],
