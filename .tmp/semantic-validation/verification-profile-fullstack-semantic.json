{
  "profile_id": "semantic-validation-fullstack-semantic",
  "label": "Semantic Validation Fullstack Deterministic",
  "bundle_label": "Semantic Validation Fullstack Deterministic",
  "target_family": "fullstack-app",
  "validation_lane": "deterministic_semantic",
  "expected_target_surfaces": [
    "api"
  ],
  "required_live_verification_modes": [
    "browser",
    "api"
  ],
  "target_reached_requires_core_probes": true,
  "minimum_feature_release_assertions": 9,
  "minimum_assertion_tag_counts": {
    "api": 7,
    "persistence": 4,
    "error_path": 1,
    "workflow_multi_step": 6,
    "consistency": 3
  },
  "score_policy": {
    "proof_weights": {
      "proof_pass_rate": 0.25,
      "criterion_pass_rate": 0.35,
      "threshold_verdict": 0.1,
      "external_grade": 0.3
    },
    "release_weights": {
      "control_plane_score": 0.45,
      "proof_score": 0.55
    }
  },
  "core_probes": [
    {
      "probe_id": "fullstack-semantic-health",
      "label": "Fullstack semantic lane health endpoint",
      "role": "supporting",
      "mode": "http",
      "target_manifest_key": "health_url",
      "expected_value": "\"status\":\"ready\"",
      "required": true
    },
    {
      "probe_id": "fullstack-semantic-shell",
      "label": "Fullstack semantic lane confirms the shell remains visible",
      "role": "release_gate",
      "mode": "http_json",
      "assertion_id": "ui_shell_renders",
      "assertion_tags": [
        "api"
      ],
      "semantic_level": "feature",
      "target_manifest_key": "api_base_url",
      "target_path": "fullstack/shell",
      "json_path": "shell",
      "expected_value": "visible",
      "expected_status": 200,
      "required": true
    },
    {
      "probe_id": "fullstack-semantic-item",
      "label": "Fullstack semantic lane confirms the latest item persists",
