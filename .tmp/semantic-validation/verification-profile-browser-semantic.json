{
  "profile_id": "semantic-validation-browser-semantic",
  "label": "Semantic Validation Browser Deterministic",
  "bundle_label": "Semantic Validation Browser Deterministic",
  "target_family": "browser-app",
  "validation_lane": "deterministic_semantic",
  "expected_target_surfaces": [
    "api"
  ],
  "required_live_verification_modes": [
    "browser",
    "api"
  ],
  "target_reached_requires_core_probes": true,
  "minimum_feature_release_assertions": 7,
  "minimum_assertion_tag_counts": {
    "api": 6,
    "error_path": 1,
    "persistence": 3,
    "workflow_multi_step": 5,
    "consistency": 1
  },
  "score_policy": {
    "proof_weights": {
      "proof_pass_rate": 0.25,
      "criterion_pass_rate": 0.35,
      "threshold_verdict": 0.1,
      "external_grade": 0.3
    },
    "release_weights": {
      "control_plane_score": 0.4,
      "proof_score": 0.6
    }
  },
  "core_probes": [
    {
      "probe_id": "browser-semantic-health",
      "label": "Browser semantic lane health endpoint",
      "role": "supporting",
      "mode": "http",
      "target_manifest_key": "health_url",
      "expected_value": "\"status\":\"ready\"",
      "required": true
    },
    {
      "probe_id": "browser-semantic-shell",
      "label": "Browser semantic lane confirms the shell remains visible",
      "role": "release_gate",
      "mode": "http_json",
      "assertion_id": "ui_shell_renders",
      "assertion_tags": [
        "api"
      ],
      "semantic_level": "feature",
      "target_manifest_key": "api_base_url",
      "target_path": "browser/summary",
      "json_path": "shell",
      "expected_value": "visible",
      "expected_status": 200,
      "required": true
    },
    {
      "probe_id": "browser-semantic-invalid-flow",
      "label": "Browser semantic lane confirms invalid form flows are rejected",
      "role": "release_gate",
      "mode": "http_json",
