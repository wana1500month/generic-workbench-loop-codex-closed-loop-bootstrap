      "semantic_level": "workflow",
      "target_manifest_key": "api_base_url",
      "target_path": "browser/invalid",
      "json_path": "status",
      "expected_value": "rejected",
      "expected_status": 400,
      "required": true
    },
    {
      "probe_id": "browser-semantic-draft",
      "label": "Browser semantic lane confirms draft state persists",
      "role": "release_gate",
      "mode": "http_json",
      "assertion_id": "draft_persists",
