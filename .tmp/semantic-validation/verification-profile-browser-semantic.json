        "workflow_multi_step"
      ],
      "semantic_level": "workflow",
      "target_manifest_key": "api_base_url",
      "target_path": "browser/draft",
      "json_path": "status",
      "expected_value": "persisted",
      "expected_status": 200,
      "required": true
    },
    {
      "probe_id": "browser-semantic-navigation",
