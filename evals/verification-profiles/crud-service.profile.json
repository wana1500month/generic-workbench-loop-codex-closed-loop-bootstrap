{
  "profile_id": "crud-service-profile",
  "label": "CRUD Service Acceptance Pack",
  "bundle_label": "CRUD Service Acceptance Pack",
  "target_family": "crud-api",
  "validation_lane": "deterministic_semantic",
  "expected_target_surfaces": [
    "api"
  ],
  "required_live_verification_modes": [
    "api"
  ],
  "target_reached_requires_core_probes": true,
  "minimum_feature_release_assertions": 6,
  "minimum_assertion_tag_counts": {
    "api": 5,
    "persistence": 1,
    "error_path": 2,
    "consistency": 2,
    "workflow_multi_step": 3
  },
  "score_policy": {
    "proof_weights": {
      "proof_pass_rate": 0.3,
      "criterion_pass_rate": 0.35,
      "threshold_verdict": 0.1,
      "external_grade": 0.25
    },
    "release_weights": {
      "control_plane_score": 0.45,
      "proof_score": 0.55
    }
  },
  "core_probes": [
    {
      "probe_id": "crud-health",
      "label": "CRUD service health endpoint",
      "role": "supporting",
      "mode": "http",
      "target_manifest_key": "health_url",
      "expected_value": "\"status\":\"ready\"",
      "required": true
    },
    {
      "probe_id": "crud-item-persists",
      "label": "Created item remains readable from the canonical collection endpoint",
      "role": "release_gate",
      "mode": "http_json",
      "assertion_id": "item_persists",
      "assertion_tags": [
        "api",
        "persistence",
        "consistency",
        "workflow_multi_step"
      ],
      "semantic_level": "workflow",
      "target_manifest_key": "api_base_url",
      "target_path": "items/latest",
      "json_path": "title",
      "expected_value": "Smoke Item",
      "expected_status": 200,
      "required": true
    },
    {
      "probe_id": "crud-invalid-item-rejected",
      "label": "Malformed CRUD request returns an explicit rejection payload",
      "role": "release_gate",
      "mode": "http_json",
      "assertion_id": "invalid_item_rejected",
      "assertion_tags": [
        "api",
        "error_path"
      ],
      "semantic_level": "workflow",
      "target_manifest_key": "api_base_url",
      "target_path": "items/invalid",
      "json_path": "error",
      "expected_value": "invalid_title",
      "expected_status": 400,
      "required": true
    },
    {
      "probe_id": "crud-item-summary-consistent",
      "label": "Canonical CRUD summary remains internally consistent after updates",
      "role": "release_gate",
      "mode": "http_json",
      "assertion_id": "collection_consistent",
      "assertion_tags": [
        "api",
        "consistency",
        "workflow_multi_step"
      ],
      "semantic_level": "workflow",
      "target_manifest_key": "api_base_url",
      "target_path": "items/summary",
      "json_path": "status",
      "expected_value": "consistent",
      "expected_status": 200,
      "required": true
    },
    {
      "probe_id": "crud-idempotent-write-safe",
      "label": "Repeated CRUD writes remain idempotent through the canonical API",
      "role": "release_gate",
      "mode": "http_json",
      "assertion_id": "idempotent_write_safe",
      "assertion_tags": [
        "api",
        "consistency",
        "workflow_multi_step"
      ],
      "semantic_level": "workflow",
      "target_manifest_key": "api_base_url",
      "target_path": "items/idempotent",
      "json_path": "status",
      "expected_value": "idempotent",
      "expected_status": 200,
      "required": true
    },
    {
      "probe_id": "crud-stale-write-rejected",
      "label": "Stale CRUD writes are rejected explicitly",
      "role": "release_gate",
      "mode": "http_json",
      "assertion_id": "stale_write_rejected",
      "assertion_tags": [
        "api",
        "error_path",
        "workflow_multi_step"
      ],
      "semantic_level": "workflow",
      "target_manifest_key": "api_base_url",
      "target_path": "items/stale",
      "json_path": "status",
      "expected_value": "stale_rejected",
      "expected_status": 409,
      "required": true
    },
    {
      "probe_id": "crud-pagination-consistent",
      "label": "CRUD pagination stays stable across repeated reads",
      "role": "release_gate",
      "mode": "http_json",
      "assertion_id": "pagination_consistent",
      "assertion_tags": [
        "api",
        "consistency",
        "workflow_multi_step"
      ],
      "semantic_level": "workflow",
      "target_manifest_key": "api_base_url",
      "target_path": "items/pagination",
      "json_path": "status",
      "expected_value": "stable",
      "expected_status": 200,
      "required": true
    }
  ],
  "criteria": [
    {
      "criterion_id": "item_persists",
      "assertion_id": "item_persists",
      "capability": "run_checks",
      "summary": "run_checks must confirm the most recent item is still readable from the API.",
      "operator": "equals",
      "expected_value": "persisted",
      "hard": true
    },
    {
      "criterion_id": "invalid_item_rejected",
      "assertion_id": "invalid_item_rejected",
      "capability": "run_checks",
      "summary": "run_checks must confirm malformed CRUD input is rejected explicitly.",
      "operator": "equals",
      "expected_value": "rejected",
      "hard": true
    },
    {
      "criterion_id": "collection_consistent",
      "assertion_id": "collection_consistent",
      "capability": "run_checks",
      "summary": "run_checks must confirm the canonical CRUD summary stays internally consistent.",
      "operator": "equals",
      "expected_value": "consistent",
      "hard": true
    },
    {
      "criterion_id": "idempotent_write_safe",
      "assertion_id": "idempotent_write_safe",
      "capability": "run_checks",
      "summary": "run_checks must confirm repeated CRUD writes remain idempotent.",
      "operator": "equals",
      "expected_value": "idempotent",
      "hard": true
    },
    {
      "criterion_id": "item_persists",
      "assertion_id": "item_persists",
      "capability": "grade_round",
      "summary": "grade_round must keep the persistence workflow green before release.",
      "operator": "equals",
      "expected_value": "persisted",
      "hard": true
    },
    {
      "criterion_id": "stale_write_rejected",
      "assertion_id": "stale_write_rejected",
      "capability": "run_checks",
      "summary": "run_checks must confirm stale CRUD writes are rejected explicitly.",
      "operator": "equals",
      "expected_value": "stale_rejected",
      "hard": true
    },
    {
      "criterion_id": "pagination_consistent",
      "assertion_id": "pagination_consistent",
      "capability": "run_checks",
      "summary": "run_checks must confirm CRUD pagination remains stable across repeated reads.",
      "operator": "equals",
      "expected_value": "stable",
      "hard": true
    }
  ],
  "notes": [
    "Use this pack when the target family is a CRUD-style API service.",
    "Release quality means the canonical persistence path, malformed-input rejection, summary consistency, and idempotent write behavior all hold under skeptical QA.",
    "Release quality now also requires explicit stale-write rejection and stable pagination behavior."
  ]
}
