{
  "profile_id": "browser-app-profile",
  "label": "Browser App Evaluator Bundle",
  "bundle_label": "Browser App Evaluator Bundle",
  "target_family": "browser-app",
  "validation_lane": "environment_integration",
  "expected_target_surfaces": [
    "browser",
    "api"
  ],
  "required_live_verification_modes": [
    "browser",
    "api"
  ],
  "target_reached_requires_core_probes": true,
  "minimum_feature_release_assertions": 7,
  "minimum_assertion_tag_counts": {
    "browser": 2,
    "error_path": 1,
    "persistence": 3,
    "workflow_multi_step": 4,
    "consistency": 1
  },
  "score_policy": {
    "proof_weights": {
      "proof_pass_rate": 0.25,
      "criterion_pass_rate": 0.35,
      "threshold_verdict": 0.1,
      "external_grade": 0.3
    },
    "release_weights": {
      "control_plane_score": 0.4,
      "proof_score": 0.6
    }
  },
  "core_probes": [
    {
      "probe_id": "browser-health",
      "label": "Live browser target health endpoint",
      "role": "supporting",
      "mode": "http",
      "target_manifest_key": "health_url",
      "expected_value": "\"status\":\"ready\"",
      "required": true
    },
    {
      "probe_id": "app-shell-renders",
      "label": "App shell renders in the browser",
      "role": "release_gate",
      "mode": "browser_journey",
      "assertion_id": "ui_shell_renders",
      "assertion_tags": [
        "browser"
      ],
      "semantic_level": "feature",
      "target_manifest_key": "app_url",
      "steps": [
        {
          "action": "goto"
        },
        {
          "action": "assert_visible",
          "selector": "[data-testid='app-shell']"
        }
      ],
      "required": true
    },
    {
      "probe_id": "invalid-flow-rejected",
      "label": "Invalid browser flow shows a visible error state",
      "role": "release_gate",
      "mode": "browser_journey",
      "assertion_id": "invalid_form_rejected",
      "assertion_tags": [
        "browser",
        "error_path"
      ],
      "semantic_level": "workflow",
      "target_manifest_key": "app_url",
      "steps": [
        {
          "action": "goto",
          "value": "?fixture=invalid"
        },
        {
          "action": "assert_visible",
          "selector": "[data-testid='error-banner']"
        }
      ],
      "required": true
    },
    {
      "probe_id": "draft-persists",
      "label": "Browser draft state persists through the supporting API",
      "role": "release_gate",
      "mode": "http_json",
      "assertion_id": "draft_persists",
      "assertion_tags": [
        "persistence",
        "workflow_multi_step"
      ],
      "semantic_level": "workflow",
      "target_manifest_key": "api_base_url",
      "target_path": "browser/draft",
      "json_path": "status",
      "expected_value": "persisted",
      "expected_status": 200,
      "required": true
    },
    {
      "probe_id": "navigation-state-preserved",
      "label": "Browser navigation state remains continuous across the workflow",
      "role": "release_gate",
      "mode": "http_json",
      "assertion_id": "navigation_state_preserved",
      "assertion_tags": [
        "api",
        "workflow_multi_step"
      ],
      "semantic_level": "workflow",
      "target_manifest_key": "api_base_url",
      "target_path": "browser/navigation",
      "json_path": "status",
      "expected_value": "preserved",
      "expected_status": 200,
      "required": true
    },
    {
      "probe_id": "refresh-state-persisted",
      "label": "Browser refresh preserves active draft state",
      "role": "release_gate",
      "mode": "http_json",
      "assertion_id": "refresh_state_persisted",
      "assertion_tags": [
        "api",
        "persistence",
        "workflow_multi_step"
      ],
      "semantic_level": "workflow",
      "target_manifest_key": "api_base_url",
      "target_path": "browser/refresh",
      "json_path": "status",
      "expected_value": "persisted",
      "expected_status": 200,
      "required": true
    },
    {
      "probe_id": "submission-roundtrip-consistent",
      "label": "Browser submission roundtrip remains consistent",
      "role": "release_gate",
      "mode": "http_json",
      "assertion_id": "submission_roundtrip_consistent",
      "assertion_tags": [
        "api",
        "consistency",
        "workflow_multi_step"
      ],
      "semantic_level": "workflow",
      "target_manifest_key": "api_base_url",
      "target_path": "browser/submit",
      "json_path": "status",
      "expected_value": "consistent",
      "expected_status": 200,
      "required": true
    },
    {
      "probe_id": "draft-restore-after-refresh",
      "label": "Browser draft state restores coherently after a refresh boundary",
      "role": "release_gate",
      "mode": "http_json",
      "assertion_id": "draft_restore_after_refresh",
      "assertion_tags": [
        "api",
        "persistence",
        "workflow_multi_step"
      ],
      "semantic_level": "workflow",
      "target_manifest_key": "api_base_url",
      "target_path": "browser/draft-restore",
      "json_path": "status",
      "expected_value": "restored",
      "expected_status": 200,
      "required": true
    }
  ],
  "criteria": [
    {
      "criterion_id": "ui_shell_renders",
      "assertion_id": "ui_shell_renders",
      "capability": "run_checks",
      "summary": "run_checks must observe a visible app shell.",
      "operator": "equals",
      "expected_value": "visible",
      "hard": true
    },
    {
      "criterion_id": "invalid_form_rejected",
      "assertion_id": "invalid_form_rejected",
      "capability": "run_checks",
      "summary": "run_checks must observe the invalid browser flow rejection state.",
      "operator": "equals",
      "expected_value": "rejected",
      "hard": true
    },
    {
      "criterion_id": "draft_persists",
      "assertion_id": "draft_persists",
      "capability": "run_checks",
      "summary": "run_checks must confirm browser draft state persists across the workflow.",
      "operator": "equals",
      "expected_value": "persisted",
      "hard": true
    },
    {
      "criterion_id": "navigation_state_preserved",
      "assertion_id": "navigation_state_preserved",
      "capability": "run_checks",
      "summary": "run_checks must confirm browser navigation state stays continuous across the workflow.",
      "operator": "equals",
      "expected_value": "preserved",
      "hard": true
    },
    {
      "criterion_id": "draft_persists",
      "assertion_id": "draft_persists",
      "capability": "grade_round",
      "summary": "grade_round must keep the browser draft-state assertion green before release.",
      "operator": "equals",
      "expected_value": "persisted",
      "hard": true
    },
    {
      "criterion_id": "refresh_state_persisted",
      "assertion_id": "refresh_state_persisted",
      "capability": "run_checks",
      "summary": "run_checks must confirm browser state survives refresh without losing the active draft.",
      "operator": "equals",
      "expected_value": "persisted",
      "hard": true
    },
    {
      "criterion_id": "submission_roundtrip_consistent",
      "assertion_id": "submission_roundtrip_consistent",
      "capability": "run_checks",
      "summary": "run_checks must confirm browser submission roundtrip state remains consistent.",
      "operator": "equals",
      "expected_value": "consistent",
      "hard": true
    },
    {
      "criterion_id": "draft_restore_after_refresh",
      "assertion_id": "draft_restore_after_refresh",
      "capability": "run_checks",
      "summary": "run_checks must confirm browser draft state restores cleanly after refresh.",
      "operator": "equals",
      "expected_value": "restored",
      "hard": true
    }
  ],
  "notes": [
    "Use this bundle for browser-first products that do not require a full API business workflow.",
    "The bundle requires one browser happy-path assertion, one browser error-path assertion, one persisted browser-workflow assertion, and one navigation-continuity assertion.",
    "The proof score includes external_grade so weak verifier grading still blocks release closure.",
    "Release quality now also requires draft restore continuity across a refresh boundary."
  ]
}
